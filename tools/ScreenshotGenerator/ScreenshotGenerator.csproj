<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Compiles the monitor's own rendering code so the images match the clock exactly -->
  <ItemGroup>
    <Compile Include="..\..\Display\*.cs" LinkBase="Display" />
    <Compile Include="..\..\Configuration\MonitorOptions.cs" LinkBase="Configuration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

</Project>
